        </mxCell>
        <mxCell id="tr_respins_fin" edge="1" parent="1" source="st_respins" target="final_respins" style="endArrow=block;html=1;strokeColor=#000000;strokeWidth=1.5;endFill=1;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- State 4: Contractat -->
        <mxCell id="st_contractat" value="Contractat&#xa;---------------------------------------&#xa;entry / atribuieNumarContractFinantare()&#xa;entry / confirmaBugeteParteneri()&#xa;exit / deblocheazaCalendarActivitati()" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;align=left;spacingLeft=10;fillColor=#d5e8d4;strokeColor=#82b366;shadow=1;" vertex="1" parent="1">
