        <!-- COMPOSITE STATE 5: Implementare -->
        <mxCell id="st_implementare" value="Implementare (Macro-Stare Operațională)&#xa;entry / demareazaExecutieProiect()&#xa;exit / verificaFinalizareActivitati()" style="swimlane;whiteSpace=wrap;html=1;startSize=40;fontStyle=1;fontSize=12;fontFamily=Helvetica;fillColor=#f8f9fa;strokeColor=#2b579a;strokeWidth=2;collapsible=0;rounded=1;shadow=1;" vertex="1" parent="1">
