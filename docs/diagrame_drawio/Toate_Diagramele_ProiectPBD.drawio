        <!-- State 6: Finalizat -->
        <mxCell id="st_finalizat" value="Finalizat&#xa;---------------------------------------&#xa;entry / intocmesteRaportFinalExecutie()&#xa;entry / arhiveazaPisteAudit()&#xa;entry / elibereazaGarantieBunaExecutie()" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;align=left;spacingLeft=10;fillColor=#d5e8d4;strokeColor=#82b366;shadow=1;" vertex="1" parent="1">
