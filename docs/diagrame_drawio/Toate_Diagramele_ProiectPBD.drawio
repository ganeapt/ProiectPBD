        <!-- CR Aprobata -->
        <mxCell id="st_cr_aprobata" value="CR: Aprobată&#xa;------------------------------------&#xa;entry / calculeazaSumaAprobata()&#xa;entry / aplicaCorectiiFinanciareDacaExista()&#xa;entry / autorizeazaPlataTrezorerie()&#xa;exit / actualizeazaExecutieBugetara()" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;align=left;spacingLeft=8;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="sub_rambursare">
