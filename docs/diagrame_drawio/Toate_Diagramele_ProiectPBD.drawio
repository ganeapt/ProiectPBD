        <!-- CR Respinsa -->
        <mxCell id="st_cr_respinsa" value="CR: Respinsă&#xa;------------------------------------&#xa;entry / intocmesteRaportNeconformitate()&#xa;entry / deblocheazaDocumentePentruCorectie()" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;align=left;spacingLeft=8;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="sub_rambursare">
