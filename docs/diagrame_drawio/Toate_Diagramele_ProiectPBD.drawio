        <mxCell id="st_cr_verif" value="CR: In_Verificare&#xa;------------------------------------&#xa;entry / alocaOfiterAM(id_ofiter)&#xa;do / verificaEligibilitateCheltuieli()&#xa;do / verificaCorelareLivrabile()" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;align=left;spacingLeft=8;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="sub_rambursare">
          <mxGeometry x="410" y="40" width="220" height="65" as="geometry" />
        </mxCell>
        <mxCell id="tr_sub2_2" edge="1" parent="sub_rambursare" source="st_cr_depusa" target="st_cr_verif" style="endArrow=block;html=1;strokeColor=#000000;endFill=1;">
