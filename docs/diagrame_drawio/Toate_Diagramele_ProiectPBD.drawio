        <mxCell id="tr_sub2_3" edge="1" parent="sub_rambursare" source="st_cr_verif" target="dec_cr" style="endArrow=block;html=1;strokeColor=#000000;endFill=1;">
          <mxGeometry relative="1" as="geometry" />
