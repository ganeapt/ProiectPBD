        <mxCell id="st_livrabil_livrat" value="Livrabil: Livrat&#xa;------------------------------------&#xa;entry / incarcaDocumentLivrabil()&#xa;entry / marcheazaDataLivrare()&#xa;do / asteaptaVerificareOfiter()" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;align=left;spacingLeft=8;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="sub_livrabile">
          <mxGeometry x="380" y="40" width="210" height="65" as="geometry" />
