<diagram id="diag_stare" name="Diagrama de Stare">
    <mxGraphModel dx="1600" dy="1200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1650" pageHeight="1300" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Header -->
        <mxCell id="header_stare" value="Diagrama de Stare UML (State Machine Diagram) - Ciclu de Viață Proiect &amp; Rambursare&#xa;ProiectPBD - Sistem de Management al Proiectelor Europene" style="rounded=1;whiteSpace=wrap;html=1;fontSize=15;fontStyle=1;fillColor=#107c41;strokeColor=#0b552d;fontColor=#ffffff;align=center;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="120" y="20" width="1400" height="50" as="geometry" />
        </mxCell>

        <!-- Initial Pseudo-State -->
        <mxCell id="st_init" value="" style="ellipse;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="70" y="140" width="30" height="30" as="geometry" />
        </mxCell>

        <!-- State 1: Draft -->
        <mxCell id="st_draft" value="Draft (Ciornă)&#xa;---------------------------------------&#xa;entry / initDateProiect(acronim, idApel)&#xa;do / configureazaConsortiuParteneri()&#xa;do / definesteLiniiBugetare()&#xa;do / planificaActivitatiSiLivrabile()&#xa;exit / valideazaPlafoaneApel()" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;align=left;spacingLeft=10;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=0;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="160" y="105" width="260" height="100" as="geometry" />
        </mxCell>

        <mxCell id="tr_init_draft" edge="1" parent="1" source="st_init" target="st_draft" style="endArrow=block;html=1;strokeColor=#000000;strokeWidth=1.5;endFill=1;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="lbl_init_draft" value="creareProiect()" style="text;html=1;fontSize=10;fontStyle=2;align=center;" vertex="1" parent="1">
          <mxGeometry x="85" y="130" width="80" height="20" as="geometry" />
        </mxCell>

        <!-- State 2: Depus -->
        <mxCell id="st_depus" value="Depus&#xa;---------------------------------------&#xa;entry / setTimestamp(data_depunere)&#xa;entry / blocheazaEditareFormular()&#xa;do / asteaptaInchidereApel()" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;align=left;spacingLeft=10;fillColor=#dae8fc;strokeColor=#6c8ebf;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="510" y="110" width="230" height="90" as="geometry" />
        </mxCell>

        <mxCell id="tr_draft_depus" edge="1" parent="1" source="st_draft" target="st_depus" style="endArrow=block;html=1;strokeColor=#000000;strokeWidth=1.5;endFill=1;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="lbl_draft_depus" value="depuneProiect() [buget_total &lt;= buget_apel &amp;&amp; areParteneri]&#xa;/ genereazaNumarInregistrare()" style="text;html=1;fontSize=10;fontStyle=2;align=center;" vertex="1" parent="1">
          <mxGeometry x="380" y="75" width="220" height="35" as="geometry" />
        </mxCell>

        <!-- State 3: In_Evaluare -->
        <mxCell id="st_eval" value="In_Evaluare&#xa;---------------------------------------&#xa;entry / alocaEvaluatori(idProiect, idEvaluator)&#xa;do / evalueazaCriteriiAdministrative()&#xa;do / evalueazaCriteriiTehnicoFinanciare()&#xa;exit / calculeazaPunctajTotal()" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;align=left;spacingLeft=10;fillColor=#fff2cc;strokeColor=#d6b656;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="840" y="110" width="260" height="90" as="geometry" />
        </mxCell>

        <mxCell id="tr_depus_eval" edge="1" parent="1" source="st_depus" target="st_eval" style="endArrow=block;html=1;strokeColor=#000000;strokeWidth=1.5;endFill=1;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="lbl_depus_eval" value="deschidereSesiuneEvaluare()&#xa;/ distribuieDosare()" style="text;html=1;fontSize=10;fontStyle=2;align=center;" vertex="1" parent="1">
          <mxGeometry x="720" y="115" width="130" height="30" as="geometry" />
        </mxCell>

        <!-- Self Loop: Clarificari -->
        <mxCell id="tr_clarificari" edge="1" parent="1" source="st_eval" target="st_eval" style="endArrow=block;html=1;strokeColor=#b85450;strokeWidth=1.5;endFill=1;rounded=1;">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="930" y="50" />
              <mxPoint x="1010" y="50" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="lbl_clarificari" value="solicitaClarificari() / primesteRaspuns()" style="text;html=1;fontSize=10;fontStyle=2;align=center;fontColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="870" y="30" width="200" height="20" as="geometry" />
        </mxCell>

        <!-- Decision Diamond for Evaluation -->
        <mxCell id="dec_eval" value="" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="1190" y="132.5" width="45" height="45" as="geometry" />
        </mxCell>

        <mxCell id="tr_eval_dec" edge="1" parent="1" source="st_eval" target="dec_eval" style="endArrow=block;html=1;strokeColor=#000000;strokeWidth=1.5;endFill=1;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="lbl_eval_dec" value="finalizareEvaluare()&#xa;/ emiteDecizie()" style="text;html=1;fontSize=10;fontStyle=2;align=center;" vertex="1" parent="1">
          <mxGeometry x="1090" y="115" width="105" height="30" as="geometry" />
        </mxCell>

        <!-- State: Respins -->
        <mxCell id="st_respins" value="Respins&#xa;---------------------------------------&#xa;entry / notificaSolicitant(decizie, motiv)&#xa;entry / arhiveazaDosarProiect()" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;align=left;spacingLeft=10;fillColor=#f8cecc;strokeColor=#b85450;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="1350" y="115" width="210" height="80" as="geometry" />
