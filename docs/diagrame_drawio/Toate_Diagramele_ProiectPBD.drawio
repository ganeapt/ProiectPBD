        <mxCell id="st_cr_depusa" value="CR: Depusă&#xa;------------------------------------&#xa;entry / ataseazaFacturiSiOP()&#xa;entry / asociazaLivrabileAprobate()&#xa;do / blocheazaLiniiBugetarePerioada()" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;align=left;spacingLeft=8;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="sub_rambursare">
