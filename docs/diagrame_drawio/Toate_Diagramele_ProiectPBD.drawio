          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="lbl_dec_respins" value="[punctaj_total &lt; 70 ||&#xa;decizie == 'Respins']" style="text;html=1;fontSize=10;fontStyle=2;align=center;fontColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="1225" y="115" width="125" height="30" as="geometry" />
        </mxCell>

        <!-- Final State from Respins -->
