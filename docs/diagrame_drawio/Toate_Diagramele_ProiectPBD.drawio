        <mxCell id="st_act_lucru" value="Activitate: În Derulare (0-99%)&#xa;Livrabil: In_Lucru&#xa;------------------------------------&#xa;do / executaSarciniProiect()&#xa;do / actualizeazaProcentRealizat()" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;align=left;spacingLeft=8;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="sub_livrabile">
