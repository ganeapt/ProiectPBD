        <mxCell id="lbl_sub2_apr" value="[documente valide &amp;&amp; livrabile confirmate]" style="text;html=1;fontSize=9;fontStyle=2;align=center;fontColor=#107c41;" vertex="1" parent="sub_rambursare">
