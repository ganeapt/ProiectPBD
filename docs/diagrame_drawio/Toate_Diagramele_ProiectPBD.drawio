<mxfile host="app.diagrams.net">
<diagram id="diag_func_nonfunc" name="Diagrama Functionala si Nonfunctionala">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1650" pageHeight="1150" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Header Banner -->
        <mxCell id="header" value="ProiectPBD - Structura Cerințelor Funcționale și Non-funcționale&#xa;Sistem Informatic pentru Gestiunea Proiectelor cu Finanțare Europeană" style="rounded=1;whiteSpace=wrap;html=1;fontSize=16;fontStyle=1;fillColor=#107c41;strokeColor=#0b552d;fontColor=#ffffff;align=center;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="100" y="20" width="1450" height="60" as="geometry" />
        </mxCell>

        <!-- Main System Node -->
        <mxCell id="sys_node" value="Sistem de Gestiune a Proiectelor Europene&#xa;(ProiectPBD)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;fontStyle=1;fillColor=#2b579a;strokeColor=#1e395b;fontColor=#ffffff;align=center;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="650" y="105" width="350" height="55" as="geometry" />
        </mxCell>

        <!-- BRANCH 1: CERINTE FUNCTIONALE -->
        <mxCell id="cf_root" value="CERINȚE FUNCȚIONALE (CF)&#xa;Capabilități &amp; Servicii Oferite Utilizatorilor" style="swimlane;whiteSpace=wrap;html=1;startSize=35;fontStyle=1;fontSize=13;fontFamily=Helvetica;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#000000;collapsible=0;rounded=1;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="190" width="760" height="910" as="geometry" />
        </mxCell>

        <!-- CF Connector -->
        <mxCell id="edge_cf" edge="1" parent="1" source="sys_node" target="cf_root" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6c8ebf;strokeWidth=3;">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="720" y="160" />
              <mxPoint x="420" y="160" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- CF1 -->
        <mxCell id="cf1" value="CF1. Gestiune Utilizatori &amp; Apeluri de Proiecte" style="rounded=1;whiteSpace=wrap;html=1;fontStyle=1;fontSize=12;fillColor=#e1d5e7;strokeColor=#9673a6;align=left;spacingLeft=10;" vertex="1" parent="cf_root">
          <mxGeometry x="20" y="45" width="720" height="135" as="geometry" />
        </mxCell>
        <mxCell id="cf1_txt" value="• CF1.1 Autentificare securizată și control acces pe bază de roluri (Solicitant, Evaluator, Ofițer AM, Administrator).&#xa;• CF1.2 Gestiunea organizațiilor partenere (denumire, CUI, IBAN, tip: IMM, Universitate, ONG, Cercetare, Mare).&#xa;• CF1.3 Publicarea și configurarea apelurilor de proiecte (cod unic apel, buget total, % cofinanțare, perioadă depunere).&#xa;• CF1.4 Activarea/dezactivarea conturilor de utilizator și alocarea drepturilor administrative specifice." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=11;fontColor=#333333;" vertex="1" parent="cf1">
          <mxGeometry x="10" y="30" width="700" height="95" as="geometry" />
        </mxCell>

        <!-- CF2 -->
        <mxCell id="cf2" value="CF2. Elaborare &amp; Depunere Propuneri de Proiect" style="rounded=1;whiteSpace=wrap;html=1;fontStyle=1;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;align=left;spacingLeft=10;" vertex="1" parent="cf_root">
          <mxGeometry x="20" y="195" width="720" height="150" as="geometry" />
        </mxCell>
        <mxCell id="cf2_txt" value="• CF2.1 Inițierea proiectului în stare de 'Draft' asociat unui apel specific și organizației lider.&#xa;• CF2.2 Configurarea consorțiului prin adăugarea partenerilor asociați proiectului.&#xa;• CF2.3 Structurarea bugetului pe categorii de cheltuieli (Personal, Echipamente, Servicii, Deplasări, Regie).&#xa;• CF2.4 Planificarea calendaristică a activităților (jaloane, durată) și asumarea livrabilelor asociate fiecărei activități.&#xa;• CF2.5 Validarea încadrării în plafoanele apelului și depunerea oficială a proiectului (trecere în starea 'Depus')." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=11;fontColor=#333333;" vertex="1" parent="cf2">
          <mxGeometry x="10" y="30" width="700" height="110" as="geometry" />
        </mxCell>

        <!-- CF3 -->
        <mxCell id="cf3" value="CF3. Evaluare &amp; Contractare Proiecte" style="rounded=1;whiteSpace=wrap;html=1;fontStyle=1;fontSize=12;fillColor=#ffe6cc;strokeColor=#d79b00;align=left;spacingLeft=10;" vertex="1" parent="cf_root">
          <mxGeometry x="20" y="360" width="720" height="150" as="geometry" />
        </mxCell>
        <mxCell id="cf3_txt" value="• CF3.1 Alocarea propunerilor de proiect depuse către evaluatori independenți (trecere în starea 'In_Evaluare').&#xa;• CF3.2 Completarea fișei de evaluare conform grilei standard (criterii administrative, eligibilitate, fezabilitate tehnică).&#xa;• CF3.3 Înregistrarea punctajului total (0-100) și a deciziei comisiei: 'Admis', 'Respins' sau 'Clarificari'.&#xa;• CF3.4 Gestionarea fluxului de solicitare și încărcare a răspunsurilor la clarificări între solicitant și AM.&#xa;• CF3.5 Încheierea și semnarea contractului de finanțare pentru proiectele admise (trecere în starea 'Contractat')." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=11;fontColor=#333333;" vertex="1" parent="cf3">
          <mxGeometry x="10" y="30" width="700" height="110" as="geometry" />
        </mxCell>

        <!-- CF4 -->
        <mxCell id="cf4" value="CF4. Monitorizare Implementare &amp; Livrabile" style="rounded=1;whiteSpace=wrap;html=1;fontStyle=1;fontSize=12;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=10;" vertex="1" parent="cf_root">
          <mxGeometry x="20" y="525" width="720" height="150" as="geometry" />
        </mxCell>
        <mxCell id="cf4_txt" value="• CF4.1 Trecerea proiectului în starea 'Implementare' și monitorizarea progresului fizic per activitate (0-100%).&#xa;• CF4.2 Monitorizarea stării livrabilelor asumate ('In_Lucru' -&gt; 'Livrat' -&gt; 'Aprobat' / 'Respins').&#xa;• CF4.3 Înregistrarea fișierelor și a metadatelor asociate fiecărui livrabil realizat în cadrul activităților.&#xa;• CF4.4 Alerte automate la apropierea termenelor limită asumate pentru activități și livrabile.&#xa;• CF4.5 Marcarea proiectului ca 'Finalizat' după realizarea completă a tuturor activităților și livrabilelor." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=11;fontColor=#333333;" vertex="1" parent="cf4">
          <mxGeometry x="10" y="30" width="700" height="110" as="geometry" />
        </mxCell>

        <!-- CF5 -->
        <mxCell id="cf5" value="CF5. Execuție Financiară &amp; Cereri de Rambursare" style="rounded=1;whiteSpace=wrap;html=1;fontStyle=1;fontSize=12;fillColor=#f8cecc;strokeColor=#b85450;align=left;spacingLeft=10;" vertex="1" parent="cf_root">
          <mxGeometry x="20" y="690" width="720" height="195" as="geometry" />
        </mxCell>
        <mxCell id="cf5_txt" value="• CF5.1 Crearea cererilor de rambursare periodice/finale cu calculul automat al sumei totale solicitate.&#xa;• CF5.2 Atașarea documentelor justificative (Facturi, Ordine de Plată, State de Salarii, Bonuri Fiscale, Rapoarte Audit).&#xa;• CF5.3 Corelarea fiecărui document cu o linie bugetară specifică și verificarea valorii eligibile solicitate.&#xa;• CF5.4 Asocierea livrabilelor realizate la cererea de rambursare ca justificare tehnică a cheltuielilor efectuate.&#xa;• CF5.5 Preluarea cererii de către Ofițerul AM (starea 'In_Verificare'), validarea sumelor și emiterea deciziei ('Aprobata'/'Respinsa').&#xa;• CF5.6 Autorizarea plății și actualizarea execuției financiare la nivel de proiect și linii bugetare." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=11;fontColor=#333333;" vertex="1" parent="cf5">
          <mxGeometry x="10" y="30" width="700" height="155" as="geometry" />
        </mxCell>


        <!-- BRANCH 2: CERINTE NON-FUNCTIONALE -->
        <mxCell id="cnf_root" value="CERINȚE NON-FUNCȚIONALE (CNF)&#xa;Calitatea, Securitatea &amp; Arhitectura Sistemului" style="swimlane;whiteSpace=wrap;html=1;startSize=35;fontStyle=1;fontSize=13;fontFamily=Helvetica;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#000000;collapsible=0;rounded=1;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="850" y="190" width="760" height="910" as="geometry" />
        </mxCell>

        <!-- CNF Connector -->
        <mxCell id="edge_cnf" edge="1" parent="1" source="sys_node" target="cnf_root" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#82b366;strokeWidth=3;">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="930" y="160" />
              <mxPoint x="1230" y="160" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- CNF1 -->
        <mxCell id="cnf1" value="CNF1. Securitate &amp; Protecția Datelor (GDPR / ISO 27001)" style="rounded=1;whiteSpace=wrap;html=1;fontStyle=1;fontSize=12;fillColor=#f5f5f5;strokeColor=#666666;align=left;spacingLeft=10;" vertex="1" parent="cnf_root">
          <mxGeometry x="20" y="45" width="720" height="135" as="geometry" />
        </mxCell>
        <mxCell id="cnf1_txt" value="• CNF1.1 Criptarea ireversibilă a parolelor de acces în baza de date utilizând algoritmi robuști (Bcrypt / Argon2).&#xa;• CNF1.2 Control strict al accesului bazat pe roluri (RBAC) - utilizatorii accesează doar datele autorizate rolului lor.&#xa;• CNF1.3 Protecția confidențialității documentelor financiare și a datelor comerciale conform regulamentului GDPR.&#xa;• CNF1.4 Securizarea comunicațiilor de rețea prin protocoale criptate TLS 1.3 / HTTPS și prevenirea atacurilor SQLi/XSS." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=11;fontColor=#333333;" vertex="1" parent="cnf1">
          <mxGeometry x="10" y="30" width="700" height="95" as="geometry" />
        </mxCell>

        <!-- CNF2 -->
        <mxCell id="cnf2" value="CNF2. Performanță &amp; Eficiență în Procesare" style="rounded=1;whiteSpace=wrap;html=1;fontStyle=1;fontSize=12;fillColor=#e1d5e7;strokeColor=#9673a6;align=left;spacingLeft=10;" vertex="1" parent="cnf_root">
          <mxGeometry x="20" y="195" width="720" height="135" as="geometry" />
        </mxCell>
        <mxCell id="cnf2_txt" value="• CNF2.1 Timp de răspuns &lt; 1.5 secunde pentru 95% din interogările standard (căutări apeluri, filtrare tabele).&#xa;• CNF2.2 Suport eficient pentru încărcarea documentelor justificative voluminoase (PDF, scanări facturi până la 25 MB).&#xa;• CNF2.3 Optimizarea bazei de date prin indecși unici și chei compuse pe atributele de căutare frecvente.&#xa;• CNF2.4 Scalabilitate orizontală a bazei de date relaționale pentru a gestiona consorții mari și mii de documente." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=11;fontColor=#333333;" vertex="1" parent="cnf2">
          <mxGeometry x="10" y="30" width="700" height="95" as="geometry" />
        </mxCell>

        <!-- CNF3 -->
        <mxCell id="cnf3" value="CNF3. Integritate &amp; Consistență Date (ACID)" style="rounded=1;whiteSpace=wrap;html=1;fontStyle=1;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacingLeft=10;" vertex="1" parent="cnf_root">
          <mxGeometry x="20" y="345" width="720" height="135" as="geometry" />
        </mxCell>
        <mxCell id="cnf3_txt" value="• CNF3.1 Constrângeri de integritate referențială stricte (Foreign Keys cu restricții de ștergere orfană).&#xa;• CNF3.2 Tranzacții atomice (ACID) la depunerea cererilor de rambursare și autorizarea plăților pentru prevenirea pierderilor.&#xa;• CNF3.3 Reguli de unicitate: o singură evaluare per proiect per evaluator, cod unic per apel și număr cerere per proiect.&#xa;• CNF3.4 Prevenirea incoerențelor financiare prin validarea sumei aprobate &lt;= suma eligibilă solicitată." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=11;fontColor=#333333;" vertex="1" parent="cnf3">
          <mxGeometry x="10" y="30" width="700" height="95" as="geometry" />
        </mxCell>

        <!-- CNF4 -->
        <mxCell id="cnf4" value="CNF4. Fiabilitate, Disponibilitate &amp; Recuperare" style="rounded=1;whiteSpace=wrap;html=1;fontStyle=1;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;align=left;spacingLeft=10;" vertex="1" parent="cnf_root">
          <mxGeometry x="20" y="495" width="720" height="135" as="geometry" />
        </mxCell>
        <mxCell id="cnf4_txt" value="• CNF4.1 Nivel de disponibilitate (Uptime) de minimum 99.5%, garantat 24/7 în preajma termenelor de depunere apel.&#xa;• CNF4.2 Strategie automată de backup zilnic (dump complet SQL + stocare criptată a documentelor justificative).&#xa;• CNF4.3 Timp de recuperare în caz de incident (RTO &lt; 2 ore, RPO &lt; 1 oră) cu menținerea integrității financiare.&#xa;• CNF4.4 Jurnalizarea erorilor la nivel de aplicație și trimiterea de alerte către administrator la erori critice." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=11;fontColor=#333333;" vertex="1" parent="cnf4">
          <mxGeometry x="10" y="30" width="700" height="95" as="geometry" />
        </mxCell>

        <!-- CNF5 -->
        <mxCell id="cnf5" value="CNF5. Usabilitate, Ergonomie &amp; Accesibilitate" style="rounded=1;whiteSpace=wrap;html=1;fontStyle=1;fontSize=12;fillColor=#ffe6cc;strokeColor=#d79b00;align=left;spacingLeft=10;" vertex="1" parent="cnf_root">
          <mxGeometry x="20" y="645" width="720" height="120" as="geometry" />
        </mxCell>
        <mxCell id="cnf5_txt" value="• CNF5.1 Interfață grafică modernă, structurată pe module intuitive conform rolului utilizatorului logat.&#xa;• CNF5.2 Validare formular în timp real (format CUI, IBAN, număr zecimal pentru bugete, restricții de date).&#xa;• CNF5.3 Ghidaj pas-cu-pas în completarea propunerilor de proiect și a dosarelor de rambursare financiară.&#xa;• CNF5.4 Compatibilitate multi-browser (Chrome, Edge, Firefox) și design responsive pentru ecrane desktop/laptop." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=11;fontColor=#333333;" vertex="1" parent="cnf5">
          <mxGeometry x="10" y="30" width="700" height="80" as="geometry" />
        </mxCell>

        <!-- CNF6 -->
        <mxCell id="cnf6" value="CNF6. Auditabilitate, Trasabilitate &amp; Conformitate UE" style="rounded=1;whiteSpace=wrap;html=1;fontStyle=1;fontSize=12;fillColor=#f8cecc;strokeColor=#b85450;align=left;spacingLeft=10;" vertex="1" parent="cnf_root">
          <mxGeometry x="20" y="780" width="720" height="115" as="geometry" />
        </mxCell>
        <mxCell id="cnf6_txt" value="• CNF6.1 Menținerea istoricului complet al tuturor acțiunilor critice (piste de audit pentru verificările AM/DLAF/OLAF).&#xa;• CNF6.2 Imutabilitatea cererilor de rambursare după depunere și păstrarea versiunilor inițiale ale bugetelor.&#xa;• CNF6.3 Trasabilitate bidirecțională completă: Livrabil tehnic &lt;--&gt; Activitate &lt;--&gt; Document justificativ &lt;--&gt; Plată AM." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=11;fontColor=#333333;" vertex="1" parent="cnf6">
          <mxGeometry x="10" y="25" width="700" height="80" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
<diagram id="diag_use_case" name="Diagrama Cazurilor de Utilizare">
    <mxGraphModel dx="1600" dy="1100" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1450" pageHeight="1150" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Header -->
        <mxCell id="header_uc" value="Diagrama Cazurilor de Utilizare (Use Case Diagram) - ProiectPBD&#xa;Sistem de Management al Proiectelor cu Finanțare Europeană" style="rounded=1;whiteSpace=wrap;html=1;fontSize=15;fontStyle=1;fillColor=#2b579a;strokeColor=#1e395b;fontColor=#ffffff;align=center;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="120" y="20" width="1200" height="50" as="geometry" />
        </mxCell>

        <!-- System Boundary -->
        <mxCell id="sys_box" value="Sistem ProiectPBD (Frontiera Sistemului)" style="swimlane;whiteSpace=wrap;html=1;startSize=30;fontStyle=1;fontSize=13;fontFamily=Helvetica;align=center;verticalAlign=top;fillColor=#f8f9fa;strokeColor=#2b579a;strokeWidth=2;rounded=1;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="220" y="90" width="1000" height="1020" as="geometry" />
        </mxCell>

        <!-- Package 1: Administrare & Apeluri -->
        <mxCell id="pkg_apeluri" value="Pachet 1: Gestiune Apeluri &amp; Administrare" style="swimlane;whiteSpace=wrap;html=1;startSize=26;fontStyle=1;fontSize=11;fontFamily=Helvetica;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;strokeWidth=1;collapsible=0;rounded=1;" vertex="1" parent="sys_box">
          <mxGeometry x="30" y="45" width="450" height="235" as="geometry" />
        </mxCell>

        <mxCell id="uc_adm_apel" value="Gestionează apeluri de proiecte&#xa;(buget, termene, cofinanțare)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=11;" vertex="1" parent="pkg_apeluri">
          <mxGeometry x="110" y="35" width="230" height="48" as="geometry" />
        </mxCell>

        <mxCell id="uc_adm_usr" value="Gestionează conturi utilizatori&#xa;și organizații partenere" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=11;" vertex="1" parent="pkg_apeluri">
          <mxGeometry x="110" y="100" width="230" height="48" as="geometry" />
        </mxCell>

        <mxCell id="uc_sol_apel" value="Consultă apeluri active&#xa;și ghidul solicitantului" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=11;" vertex="1" parent="pkg_apeluri">
          <mxGeometry x="110" y="165" width="230" height="48" as="geometry" />
        </mxCell>

        <!-- Package 2: Elaborare & Depunere Proiect -->
        <mxCell id="pkg_elaborare" value="Pachet 2: Elaborare &amp; Depunere Proiect" style="swimlane;whiteSpace=wrap;html=1;startSize=26;fontStyle=1;fontSize=11;fontFamily=Helvetica;fillColor=#e1d5e7;strokeColor=#9673a6;fontColor=#000000;strokeWidth=1;collapsible=0;rounded=1;" vertex="1" parent="sys_box">
          <mxGeometry x="510" y="45" width="460" height="425" as="geometry" />
        </mxCell>

        <mxCell id="uc_cr_draft" value="Creează proiect nou (Draft)&#xa;(acronim, durată, valoare)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=11;" vertex="1" parent="pkg_elaborare">
          <mxGeometry x="120" y="35" width="220" height="45" as="geometry" />
        </mxCell>

        <mxCell id="uc_cfg_cons" value="Configurează consorțiu&#xa;(adaugă parteneri proiect)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=11;" vertex="1" parent="pkg_elaborare">
          <mxGeometry x="120" y="95" width="220" height="45" as="geometry" />
        </mxCell>

        <mxCell id="uc_cpl_bug" value="Definește linii bugetare&#xa;(personal, echipamente, regie)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=11;" vertex="1" parent="pkg_elaborare">
          <mxGeometry x="120" y="155" width="220" height="45" as="geometry" />
        </mxCell>

        <mxCell id="uc_plan_act" value="Planifică activități și livrabile&#xa;(date, jaloane, asocieri)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=11;" vertex="1" parent="pkg_elaborare">
          <mxGeometry x="120" y="215" width="220" height="45" as="geometry" />
        </mxCell>

        <mxCell id="uc_dep_prj" value="Depune proiect oficial&#xa;(trecere în starea 'Depus')" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=11;fontStyle=1;" vertex="1" parent="pkg_elaborare">
          <mxGeometry x="120" y="280" width="220" height="45" as="geometry" />
        </mxCell>

        <mxCell id="uc_val_plaf" value="Validează plafoane bugetare&#xa;și eligibilitate apel" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=11;" vertex="1" parent="pkg_elaborare">
          <mxGeometry x="120" y="360" width="220" height="45" as="geometry" />
        </mxCell>

        <!-- Include Depune -> Valideaza -->
        <mxCell id="inc_dep_val" edge="1" parent="pkg_elaborare" source="uc_dep_prj" target="uc_val_plaf" style="endArrow=open;html=1;rounded=0;dashed=1;strokeColor=#000000;strokeWidth=1.5;exitX=0.5;exitY=1;entryX=0.5;entryY=0;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="lbl_inc_dep" value="&amp;lt;&amp;lt;include&amp;gt;&amp;gt;" style="text;html=1;align=center;verticalAlign=middle;fontSize=10;fontColor=#4d4d4d;fontStyle=2;" vertex="1" parent="pkg_elaborare">
          <mxGeometry x="235" y="330" width="70" height="20" as="geometry" />
        </mxCell>


        <!-- Package 3: Evaluare & Contractare -->
        <mxCell id="pkg_evaluare" value="Pachet 3: Evaluare &amp; Contractare" style="swimlane;whiteSpace=wrap;html=1;startSize=26;fontStyle=1;fontSize=11;fontFamily=Helvetica;fillColor=#ffe6cc;strokeColor=#d79b00;fontColor=#000000;strokeWidth=1;collapsible=0;rounded=1;" vertex="1" parent="sys_box">
          <mxGeometry x="510" y="490" width="460" height="505" as="geometry" />
        </mxCell>

