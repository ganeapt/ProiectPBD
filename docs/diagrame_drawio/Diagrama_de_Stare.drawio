              <mxPoint x="1315" y="260" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="lbl_dec_contractat" value="[punctaj &gt;= 70 &amp;&amp; decizie == 'Admis']&#xa;/ semneazaContractFinantare()" style="text;html=1;fontSize=10;fontStyle=2;align=center;fontColor=#107c41;" vertex="1" parent="1">
          <mxGeometry x="1220" y="220" width="190" height="30" as="geometry" />
