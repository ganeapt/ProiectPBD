<mxfile host="app.diagrams.net">
  <diagram id="diag_colaborare" name="Diagrama de Colaborare">
    <mxGraphModel dx="1600" dy="1200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1300" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Header -->
        <mxCell id="header_colab" value="Diagrama de Colaborare UML (Communication / Collaboration Diagram)&#xa;Scenariu: Depunere, Verificare și Aprobare Cerere de Rambursare cu Documente Justificative și Livrabile" style="rounded=1;whiteSpace=wrap;html=1;fontSize=15;fontStyle=1;fillColor=#2b579a;strokeColor=#1e395b;fontColor=#ffffff;align=center;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="120" y="20" width="1450" height="55" as="geometry" />
        </mxCell>

        <!-- ACTORS AND OBJECTS -->
        <!-- Actor 1: Solicitant -->
        <mxCell id="obj_solicitant" value="sol : Solicitant&#xa;(Lider Parteneriat)" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;fontStyle=1;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="90" y="170" width="45" height="85" as="geometry" />
        </mxCell>

        <!-- Boundary / UI -->
        <mxCell id="obj_ui" value="&amp;lt;&amp;lt;boundary&amp;gt;&amp;gt;&#xa;:InterfataGraficaSistem" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fontStyle=1;fillColor=#e1d5e7;strokeColor=#9673a6;align=center;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="380" y="170" width="220" height="75" as="geometry" />
        </mxCell>

        <!-- Controller -->
        <mxCell id="obj_ctrl" value="&amp;lt;&amp;lt;control&amp;gt;&amp;gt;&#xa;:ControllerRambursare" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fontStyle=1;fillColor=#ffe6cc;strokeColor=#d79b00;align=center;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="780" y="170" width="220" height="75" as="geometry" />
        </mxCell>

        <!-- Actor 2: Ofiter AM -->
        <mxCell id="obj_ofiter" value="of : OfiterAM&#xa;(Autoritate Management)" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1.5;fontStyle=1;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1460" y="170" width="45" height="85" as="geometry" />
        </mxCell>

        <!-- Entity: Proiect -->
        <mxCell id="obj_proiect" value="&amp;lt;&amp;lt;entity&amp;gt;&amp;gt;&#xa;p : Proiect" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fontStyle=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=center;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="80" y="440" width="190" height="70" as="geometry" />
        </mxCell>

        <!-- Entity: CerereRambursare -->
        <mxCell id="obj_cr" value="&amp;lt;&amp;lt;entity&amp;gt;&amp;gt;&#xa;cr : CerereRambursare" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fontStyle=1;fillColor=#fff2cc;strokeColor=#d6b656;align=center;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="785" y="440" width="210" height="70" as="geometry" />
        </mxCell>

        <!-- Entity: Livrabil -->
        <mxCell id="obj_livrabil" value="&amp;lt;&amp;lt;entity&amp;gt;&amp;gt;&#xa;liv : Livrabil" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fontStyle=1;fillColor=#d5e8d4;strokeColor=#82b366;align=center;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="1260" y="440" width="190" height="70" as="geometry" />
        </mxCell>

        <!-- Entity: DocumentJustificativ -->
        <mxCell id="obj_doc" value="&amp;lt;&amp;lt;entity&amp;gt;&amp;gt;&#xa;doc : DocumentJustificativ" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fontStyle=1;fillColor=#f8cecc;strokeColor=#b85450;align=center;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="785" y="690" width="210" height="70" as="geometry" />
        </mxCell>

        <!-- Entity: LinieBugetara -->
        <mxCell id="obj_linie" value="&amp;lt;&amp;lt;entity&amp;gt;&amp;gt;&#xa;linie : LinieBugetara" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fontStyle=1;fillColor=#f5f5f5;strokeColor=#666666;align=center;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="80" y="690" width="200" height="70" as="geometry" />
        </mxCell>

        <!-- Persistence: DB -->
        <mxCell id="obj_db" value="&amp;lt;&amp;lt;persistence&amp;gt;&amp;gt;&#xa;:BazaDeDateMySQL" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fontSize=12;fontStyle=1;fillColor=#e1d5e7;strokeColor=#9673a6;align=center;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="1275" y="660" width="160" height="110" as="geometry" />
        </mxCell>


        <!-- LINKS AND NUMBERED MESSAGES -->

        <!-- Link 1: Solicitant to UI -->
        <mxCell id="link_sol_ui" edge="1" parent="1" source="obj_solicitant" target="obj_ui" style="endArrow=none;html=1;strokeColor=#333333;strokeWidth=2;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="msg_sol_ui" value="1: initCerereRambursare(idProiect) -----------------&gt;&#xa;&lt;----------------- 6: afiseazaFormularCR(linii, livrabile)&#xa;7: completeazaDateCR(numar, sumaSolicitata) ------&gt;&#xa;8: ataseazaDocument(tip, suma, idLinie) -----------&gt;&#xa;9: selecteazaLivrabileRealizate(idLiv) ------------&gt;&#xa;&lt;----------------- 32: notificaRezultatAprobare(suma)" style="text;html=1;fontSize=10;fontColor=#003366;fontStyle=1;align=center;whiteSpace=wrap;fillColor=#f9f9f9;rounded=1;strokeColor=#cccccc;" vertex="1" parent="1">
          <mxGeometry x="135" y="80" width="255" height="85" as="geometry" />
        </mxCell>

        <!-- Link 2: UI to Controller -->
        <mxCell id="link_ui_ctrl" edge="1" parent="1" source="obj_ui" target="obj_ctrl" style="endArrow=none;html=1;strokeColor=#333333;strokeWidth=2;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="msg_ui_ctrl" value="2: getContextImplementare(idProiect) --------------&gt;&#xa;10: submitDosarRambursare(dateCR, docs, liv) ----&gt;&#xa;19: preiaCerere(idCR, idOfiter) ---------------------&gt;&#xa;24: actualizeazaValoriEligibile(docs) -----------------&gt;&#xa;28: finalizareVerificare('Aprobata', suma) ------------&gt;" style="text;html=1;fontSize=10;fontColor=#003366;fontStyle=1;align=center;whiteSpace=wrap;fillColor=#f9f9f9;rounded=1;strokeColor=#cccccc;" vertex="1" parent="1">
          <mxGeometry x="545" y="80" width="270" height="75" as="geometry" />
        </mxCell>

        <!-- Link 3: Ofiter to UI -->
        <mxCell id="link_of_ui" edge="1" parent="1" source="obj_ofiter" target="obj_ui" style="endArrow=none;html=1;strokeColor=#333333;strokeWidth=2;rounded=1;">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1480" y="320" />
              <mxPoint x="490" y="320" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="msg_of_ui" value="18: deschideDosarVerificare(idCR) ----------------&gt;&#xa;23: valideazaEligibilitate(idDoc, sumaEligibila) ---&gt;&#xa;27: autorizeazaPlata(sumaTotalaAprobata) --------&gt;" style="text;html=1;fontSize=10;fontColor=#003366;fontStyle=1;align=center;whiteSpace=wrap;fillColor=#f9f9f9;rounded=1;strokeColor=#cccccc;" vertex="1" parent="1">
          <mxGeometry x="840" y="275" width="280" height="50" as="geometry" />
        </mxCell>

        <mxCell id="link_ctrl_of" edge="1" parent="1" source="obj_ctrl" target="obj_ofiter" style="endArrow=none;html=1;strokeColor=#333333;strokeWidth=2;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="msg_ctrl_of" value="17: notificaCerereNoua(idCR, idProiect) ----&gt;" style="text;html=1;fontSize=10;fontColor=#003366;fontStyle=1;align=center;whiteSpace=wrap;fillColor=#f9f9f9;rounded=1;strokeColor=#cccccc;" vertex="1" parent="1">
          <mxGeometry x="1100" y="170" width="260" height="25" as="geometry" />
        </mxCell>

        <!-- Link 4: Controller to Proiect -->
        <mxCell id="link_ctrl_p" edge="1" parent="1" source="obj_ctrl" target="obj_proiect" style="endArrow=none;html=1;strokeColor=#333333;strokeWidth=2;rounded=1;">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="750" y="380" />
              <mxPoint x="175" y="380" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="msg_ctrl_p" value="3: verificaStareImplementare() ---------------------&gt;" style="text;html=1;fontSize=10;fontColor=#003366;fontStyle=1;align=center;whiteSpace=wrap;fillColor=#f9f9f9;rounded=1;strokeColor=#cccccc;" vertex="1" parent="1">
          <mxGeometry x="270" y="355" width="280" height="25" as="geometry" />
        </mxCell>

        <!-- Link 5: Controller to CerereRambursare -->
        <mxCell id="link_ctrl_cr" edge="1" parent="1" source="obj_ctrl" target="obj_cr" style="endArrow=none;html=1;strokeColor=#333333;strokeWidth=2;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="msg_ctrl_cr" value="11: create(nrCR, sumaSolicitata, 'Depusa') ---&gt;&#xa;20: setStare('In_Verificare', idOfiter) ---------&gt;&#xa;29: setDecizie('Aprobata', sumaAprobata) ---&gt;" style="text;html=1;fontSize=10;fontColor=#003366;fontStyle=1;align=left;whiteSpace=wrap;fillColor=#f9f9f9;rounded=1;strokeColor=#cccccc;" vertex="1" parent="1">
          <mxGeometry x="890" y="275" width="240" height="50" as="geometry" />
        </mxCell>

        <!-- Link 6: Controller to Livrabil -->
        <mxCell id="link_ctrl_liv" edge="1" parent="1" source="obj_ctrl" target="obj_livrabil" style="endArrow=none;html=1;strokeColor=#333333;strokeWidth=2;rounded=1;">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1040" y="380" />
              <mxPoint x="1355" y="380" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="msg_ctrl_liv" value="4: getLivrabileDisponibile(idProiect) ---------------&gt;&#xa;14: asociazaLaCerere(idCR) -----------------------&gt;&#xa;22: getLivrabileAsociate() --------------------------&gt;&#xa;26: setStare('Aprobat') ------------------------------&gt;" style="text;html=1;fontSize=10;fontColor=#003366;fontStyle=1;align=left;whiteSpace=wrap;fillColor=#f9f9f9;rounded=1;strokeColor=#cccccc;" vertex="1" parent="1">
          <mxGeometry x="1100" y="345" width="260" height="65" as="geometry" />
        </mxCell>

        <!-- Link 7: Controller to DocumentJustificativ -->
        <mxCell id="link_ctrl_doc" edge="1" parent="1" source="obj_ctrl" target="obj_doc" style="endArrow=none;html=1;strokeColor=#333333;strokeWidth=2;rounded=1;">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1030" y="230" />
              <mxPoint x="1030" y="725" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="msg_ctrl_doc" value="12: addDocument(tip, val, idLinie) -------------&gt;&#xa;21: getDocumenteCR() ---------------------------&gt;&#xa;25: setValoareAprobata(sumaEligibila) --------&gt;" style="text;html=1;fontSize=10;fontColor=#003366;fontStyle=1;align=left;whiteSpace=wrap;fillColor=#f9f9f9;rounded=1;strokeColor=#cccccc;" vertex="1" parent="1">
          <mxGeometry x="1040" y="550" width="250" height="50" as="geometry" />
        </mxCell>

        <!-- Link 8: DocumentJustificativ to LinieBugetara -->
        <mxCell id="link_doc_linie" edge="1" parent="1" source="obj_doc" target="obj_linie" style="endArrow=none;html=1;strokeColor=#333333;strokeWidth=2;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="msg_doc_linie" value="13: verificaIncadrarePlafon(valoare) --------------&gt;&#xa;&lt;-------------- 30: actualizeazaBugetConsumat(suma)" style="text;html=1;fontSize=10;fontColor=#003366;fontStyle=1;align=center;whiteSpace=wrap;fillColor=#f9f9f9;rounded=1;strokeColor=#cccccc;" vertex="1" parent="1">
          <mxGeometry x="360" y="695" width="310" height="35" as="geometry" />
        </mxCell>

        <!-- Link 9: Proiect to LinieBugetara -->
        <mxCell id="link_p_linie" edge="1" parent="1" source="obj_proiect" target="obj_linie" style="endArrow=none;html=1;strokeColor=#333333;strokeWidth=2;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="msg_p_linie" value="5: getLiniiBugetare() -----------------&gt;" style="text;html=1;fontSize=10;fontColor=#003366;fontStyle=1;align=center;whiteSpace=wrap;fillColor=#f9f9f9;rounded=1;strokeColor=#cccccc;" vertex="1" parent="1">
          <mxGeometry x="75" y="580" width="220" height="25" as="geometry" />
        </mxCell>

        <!-- Link 10: Cerere to Livrabil -->
        <mxCell id="link_cr_liv" edge="1" parent="1" source="obj_cr" target="obj_livrabil" style="endArrow=none;html=1;strokeColor=#333333;strokeWidth=2;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="msg_cr_liv" value="&amp;lt;-- corelare: liv.id_cr = cr.id_cr --&amp;gt;&#xa;(Livrabilul constituie document de justificare tehnică)" style="text;html=1;fontSize=9;fontColor=#666666;fontStyle=2;align=center;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="1010" y="445" width="235" height="30" as="geometry" />
        </mxCell>

        <!-- Link 11: Controller to Database -->
        <mxCell id="link_ctrl_db" edge="1" parent="1" source="obj_ctrl" target="obj_db" style="endArrow=none;html=1;strokeColor=#333333;strokeWidth=2;rounded=1;">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="960" y="630" />
              <mxPoint x="1355" y="630" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="msg_ctrl_db" value="15: saveTransaction(cr, docs, liv) -------------------&gt;&#xa;&lt;------------------- 16: confirmareSalvare()&#xa;31: commitDeciziePlata(idCR, sumaAprobata) ----&gt;" style="text;html=1;fontSize=10;fontColor=#003366;fontStyle=1;align=left;whiteSpace=wrap;fillColor=#f9f9f9;rounded=1;strokeColor=#cccccc;" vertex="1" parent="1">
          <mxGeometry x="980" y="635" width="270" height="50" as="geometry" />
        </mxCell>

        <!-- Legend Box -->
        <mxCell id="legend_box" value="Legendă &amp;amp; Convenții Notare Diagramă de Colaborare (UML 2.x):&#xa;• Dreptunghiurile reprezintă instanțele de obiecte implicate în colaborare (:NumeClasa / obiect : Clasa).&#xa;• Liniile solide (Links) reprezintă legăturile de comunicație / navigabilitate între obiecte.&#xa;• Mesajele numerotate secvențial (1:, 2:, ..., 32:) indică ordinea strictă de execuție a apelurilor de metodă.&#xa;• Săgețile (&gt; / &lt;) indică sensul expedierii mesajului între colaboratori." style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;align=left;spacingLeft=15;fillColor=#f8f9fa;strokeColor=#2b579a;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="80" y="810" width="1440" height="85" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
